<%= form_with(model: task, class: "card border-0 rounded-4 shadow-lg p-4 p-md-5 bg-white") do |form| %>
  <% if task.errors.any? %>
    <div class="alert alert-danger rounded-4 border-0 shadow-sm">
      <h5 class="alert-heading">Помилки при збереженні:</h5>
      <ul class="mb-0">
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-floating mb-4">
    <%= form.text_field :title, class: "form-control bg-light border-0", placeholder: "Назва" %>
    <%= form.label :title, "Назва завдання", class: "text-muted" %>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="form-floating">
        <%= form.select :category, Category.pluck(:name), { prompt: "Оберіть категорію" }, class: "form-select bg-light border-0" %>
        <%= form.label :category, "Категорія", class: "text-muted" %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-floating">
        <%= form.select :priority, Task.priorities.keys.map { |p| [p.titleize, p] }, {}, class: "form-select bg-light border-0" %>
        <%= form.label :priority, "Пріоритет", class: "text-muted" %>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="form-floating">
        <%= form.date_field :due_date, class: "form-control bg-light border-0" %>
        <%= form.label :due_date, "Дедлайн", class: "text-muted" %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-floating">
        <%= form.number_field :estimated_hours, class: "form-control bg-light border-0", placeholder: "Години" %>
        <%= form.label :estimated_hours, "Оцінка (год)", class: "text-muted" %>
      </div>
    </div>
  </div>

  <div class="form-floating mb-4">
    <%= form.text_area :notes, class: "form-control bg-light border-0", placeholder: "Нотатки", style: "height: 100px" %>
    <%= form.label :notes, "Нотатки", class: "text-muted" %>
  </div>

  <div class="mb-4 form-check form-switch">
    <%= form.check_box :completed, class: "form-check-input" %>
    <%= form.label :completed, "Завдання виконано", class: "form-check-label text-black" %>
  </div>

  <div class="p-4 bg-light rounded-4 mb-4">
    <h6 class="mb-3 text-primary fw-bold">📎 Вкладення до завдання (опціонально)</h6>
    <%= fields_for :attachment do |attachment_form| %>
      <div class="row g-3">
        <div class="col-md-6 form-floating">
          <%= attachment_form.text_field :filename, class: "form-control border-0", placeholder: "Назва файлу" %>
          <%= attachment_form.label :filename, "Назва файлу", class: "text-muted ms-2" %>
        </div>
        <div class="col-md-6 form-floating">
          <%= attachment_form.text_field :url, class: "form-control border-0", placeholder: "URL" %>
          <%= attachment_form.label :url, "Посилання (URL)", class: "text-muted ms-2" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-2">
    <%= form.submit "Зберегти завдання", class: "btn btn-primary btn-lg w-100 rounded-pill shadow-sm" %>
  </div>
<% end %>