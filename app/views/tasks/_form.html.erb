<%= form_with(model: task, class: "space-y-4") do |form| %>
  <div>
    <%= form.label :title, class: "block font-medium text-slate-300 mb-1" %>
    <%= form.text_field :title, class: "block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.label :category, class: "block font-medium text-slate-300  mb-1" %>
    <%= form.select :category, Category.pluck(:name), { prompt: "Select a Category" }, class: "block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.label :priority, class: "block font-medium text-slate-300  mb-1" %>
    <%= form.select :priority, Task.priorities.keys.map { |p| [p.titleize, p] }, {}, class: "block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div class="flex space-x-4">
    <div class="flex-1">
      <%= form.label :due_date, class: "block font-medium text-slate-300  mb-1" %>
      <%= form.date_field :due_date, class: "block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    <div class="flex-1">
      <%= form.label :estimated_hours, class: "block font-medium text-slate-300  mb-1" %>
      <%= form.number_field :estimated_hours, class: "dark:[color-scheme:dark] block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    </div>
  </div>

  <div class="flex items-center mt-4">
    <%= form.check_box :completed, class: "h-4 w-4 text-slate-300 focus:rtext-slate-300 border-gray-300 rounded" %>
    <%= form.label :completed, class: "ml-2 block text-sm text-slate-300" %>
  </div>

  <div class="pt-4">
    <%= form.submit class: "w-full bg-blue-600 text-white font-bold py-2 px-4 rounded shadow hover:bg-blue-700 cursor-pointer transition" %>
  </div>
<% end %>