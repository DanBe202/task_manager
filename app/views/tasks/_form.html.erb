<%= form_with(model: task) do |form| %>
  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :category, style: "display: block" %>
    <%= form.select :category, Category.pluck(:name), prompt: "Select a Category" %>
  </div>

  <div>
    <%= form.label :priority, style: "display: block" %>
    <%= form.select :priority, Task.priorities.keys.map { |p| [p.titleize, p] } %>
  </div>

  <div>
    <%= form.label :due_date, style: "display: block" %>
    <%= form.date_field :due_date %>
  </div>

  <div>
    <%= form.label :estimated_hours, style: "display: block" %>
    <%= form.number_field :estimated_hours %>
  </div>

  <div>
    <%= form.label :completed, style: "display: block" %>
    <%= form.check_box :completed %>
  </div>

  <div style="margin-top: 10px;">
    <%= form.submit %>
  </div>
<% end %>