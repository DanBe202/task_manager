<div class="max-w-2xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold text-gray-100"><%= @task.title %></h1>
    <span class="px-3 py-1 rounded-full text-sm font-semibold <%= @task.completed ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>">
      <%= @task.completed ? "Completed" : "In Progress" %>
    </span>
  </div>

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 shadow-sm space-y-4">
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <p class="text-gray-500 uppercase tracking-wider font-semibold">Category</p>
        <p class="text-gray-900 text-lg"><%= @task.category %></p>
      </div>
      <div>
        <p class="text-gray-500 uppercase tracking-wider font-semibold">Priority</p>
        <p class="text-gray-900 text-lg capitalize"><%= @task.priority %></p>
      </div>
      <div>
        <p class="text-gray-500 uppercase tracking-wider font-semibold">Due Date</p>
        <p class="text-gray-900 text-lg"><%= @task.due_date || "No date set" %></p>
      </div>
      <div>
        <p class="text-gray-500 uppercase tracking-wider font-semibold">Estimated Hours</p>
        <p class="text-gray-900 text-lg"><%= @task.estimated_hours || 0 %> hrs</p>
      </div>
    </div>
  </div>

  <div class="mt-8 flex items-center space-x-4 border-t pt-6">
    <%= link_to "Edit this task", edit_task_path(@task), class: "bg-blue-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-700 transition shadow" %>
    <%= link_to "Back to tasks", tasks_path, class: "text-gray-300 hover:text-gray-900 font-medium" %>

    <div class="flex-grow"></div>

    <%= button_to "Delete Task", @task, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-500 hover:text-red-700 text-sm font-medium" %>
  </div>
</div>