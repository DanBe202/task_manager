<div class="max-w-xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-slate-300">New Task</h1>
    <p class="text-slate-200 text-xl">Add a new item to your to-do list.</p>
  </div>

  <%= render "form", task: @task %>

  <div class="mt-6 border-t pt-4">
    <%= link_to "← Back to tasks", tasks_path, class: "text-gray-100 hover:text-blue-600 transition" %>
  </div>
</div>