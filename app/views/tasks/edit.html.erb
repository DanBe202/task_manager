<div class="max-w-xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-slate-300">Editing Task</h1>
    <p class="text-slate-200 text-xl">Update the details of your task below.</p>
  </div>

  <%= render "form", task: @task %>

  <div class="mt-6 flex items-center space-x-4 border-t pt-4 text-sm">
    <%= link_to "Show this task", @task, class: "text-blue-600 hover:underline" %>
    <span class="text-gray-300">|</span>
    <%= link_to "Back to tasks", tasks_path, class: "text-gray-200 hover:underline" %>
  </div>
</div>