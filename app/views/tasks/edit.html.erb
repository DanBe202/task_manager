<div class="row justify-content-center mb-5">
  <div class="col-lg-8 col-xl-7">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="fw-bold mb-0">Редагування</h1>
      <div>
        <%= link_to "Деталі", @task, class: "btn btn-outline-secondary rounded-pill px-3 shadow-sm me-2" %>
        <%= link_to "Назад", tasks_path, class: "btn btn-light rounded-pill px-3 shadow-sm" %>
      </div>
    </div>
    <%= render "form", task: @task %>
  </div>
</div>