<div>
  <h1>Tasks</h1>

  <div style="margin-bottom: 20px;">
    <%= link_to "Show Completed Tasks", completed_tasks_path %> |
    <%= link_to "Manage Categories", categories_path %> |
    <%= link_to "New task", new_task_path %>
  </div>

  <div id="tasks">
    <% @tasks.each do |task| %>
      <hr>
      <p>
        <strong>[<%= task.completed ? "X" : " " %>] <%= task.title %></strong>
        (Priority: <%= task.priority %>) - Category: <%= task.category %>
      </p>
      <p>
        <%= link_to "Show", task %> |
        <%= link_to "Edit", edit_task_path(task) %> |
        <%= button_to "Destroy", task, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
      </p>
    <% end %>
  </div>
</div>