<!DOCTYPE html>
<html>
<head>
  <title>TaskManager</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

  <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/zephyr/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-5 py-3">
  <div class="container">
    <%= link_to "TaskManager", tasks_path, class: "navbar-brand fw-bold fs-4" %>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto gap-2">
        <li class="nav-item">
          <%= link_to "Дедлайн цього тижня", due_this_week_tasks_path, class: "nav-link btn btn-sm btn-outline-light rounded-pill px-3 text-white" %>
        </li>
        <li class="nav-item">
          <%= link_to "Категорії", categories_path, class: "nav-link text-white" %>
        </li>
      </ul>
    </div>
  </div>
</nav>

<main class="container">
  <%= yield %>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>